# Machine-specific git settings. ./install copies this file to ~/.gitconfig.local.
# Uncomment and fill in your identity before committing.
# [user]
#	name = Your Name
#	email = you@example.com

# On WSL, reuse GitHub CLI's login for HTTPS (macOS uses the Keychain):
# [credential "https://github.com"]
#	helper = !gh auth git-credential
