[core]
	pager = less -FRSX

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	# git difftool falls back to this too.
	tool = nvimdiff
	conflictstyle = zdiff3

[rerere]
	enabled = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Name, email and machine-specific settings. Last, so they win.
# Change them with `git config --file ~/.gitconfig.local`; --global would edit this file.
[include]
	path = ~/.gitconfig.local
