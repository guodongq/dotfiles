[core]
	editor = nvim
	pager = less -FRSX

[color "branch"]
	current = green
	remote = yellow

[help]
	autocorrect = 1

[push]
	default = upstream
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[branch "master"]
	mergeoptions = --no-edit

[diff]
	colorMoved = default
	tool = nvimdiff
	algorithm = histogram

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Name, email and machine-specific settings. Last, so they win.
[include]
	path = ~/.gitconfig.local
